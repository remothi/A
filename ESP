do
local ReplicatedStorage = game:GetService("ReplicatedStorage")

if not ReplicatedStorage:GetAttribute("inDaytime") then
    ReplicatedStorage:SetAttribute("inDaytime", true)
end

ReplicatedStorage:GetAttributeChangedSignal("inDaytime"):Connect(function()
    if not ReplicatedStorage:GetAttribute("inDaytime") then
        ReplicatedStorage:SetAttribute("inDaytime", true)
    end
